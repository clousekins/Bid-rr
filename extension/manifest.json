{
  "manifest_version": 3,
  "name": "Poong Job Clipper",
  "description": "An in-page panel: clip the job posting you are looking at into Poong-Apply, turn pasted Jobright search JSON into one CSV, and on chatgpt.com, write resumes for Poong's jobs.",
  "version": "1.3.2",
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "downloads"
  ],
  "host_permissions": [
    "http://127.0.0.1:8000/*",
    "http://localhost:8000/*",
    "https://boards-api.greenhouse.io/*",
    "https://chatgpt.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Poong Job Clipper \u2014 open the panel on this page",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "options_page": "options.html",
  "web_accessible_resources": [
    {
      "resources": [
        "lib/*.js",
        "ui.css"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
