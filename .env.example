# --- LLM ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
# Simultaneous resume generations (1–32). Each job uses ~2–4 API calls.
# With ~30k TPM, start at 2; raise if your OpenAI tier allows.
TAILOR_CONCURRENCY=2
# Simultaneous deep-scan fetches
DEEP_SCAN_CONCURRENCY=3

# --- Storage ---
DATABASE_URL=sqlite:///./data/remote_apply.db
PERSONA_OUTPUT_ROOT=./data/applications

# --- Apply safety ---
AUTO_SUBMIT=false

# --- HTTP / UI ---
CORS_ORIGINS=*
ACCESS_TOKEN=
HOST=0.0.0.0
PORT=8000

# --- Octo Browser (preferred CDP) ---
OCTO_ENABLED=true
OCTO_API_URL=http://127.0.0.1:58888
OCTO_PROFILE_UUID=
OCTO_PROFILE_PASSWORD=
BROWSER_CDP_URL=
APPLY_ALLOW_LAUNCH_CHROMIUM=false

# --- Optional site login helpers ---
APPLY_LOGIN_EMAIL=
APPLY_LOGIN_PASSWORD=

# --- Applied-job Google Sheet log ---
# The sheet id is the long token in the URL:
#   docs.google.com/spreadsheets/d/<THIS PART>/edit?gid=<GID>
# Leave the tab blank to resolve by gid.
APPLIED_SHEET_ENABLED=true
APPLIED_SHEET_ID=
APPLIED_SHEET_GID=0
APPLIED_SHEET_TAB=
# The Apps Script web app is bound to one spreadsheet. Redeploy it on the
# target sheet when APPLIED_SHEET_ID changes, or leave this blank and use a
# service account, which opens the sheet by id.
APPLIED_SHEETS_WEBHOOK_URL=
GOOGLE_SERVICE_ACCOUNT_JSON=

# --- Jobright session ---
# Their search API (/swan/recommend/*) answers 401 without a signed-in
# session: "Cookie not found" with no cookie, "Illegal cookie" with a stale
# one. Paste the whole Cookie header from a logged-in browser request —
# SESSION_ID is the part that matters. Leave blank to read their public
# remote-jobs pages instead, which need no login but return far less.
JOBRIGHT_COOKIE=
